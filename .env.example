# ==========================================
# Root Environment Template - AI Fitness Platform
# Copy this file to .env or .env.production and fill in your real values.
# ==========================================

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=ai_fitness_platform
MYSQL_USER=fitness_user
MYSQL_PASSWORD=your_secure_db_password
DB_HOST=mysql
DB_PORT=3306

# --- AI & LLM Configuration (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Backend Security & JWT ---
JWT_SECRET=your_secure_random_256bit_hex_secret_key_here
JWT_EXPIRATION=86400000

# --- Mail Server (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# --- Microservices Networking ---
SPRING_PORT=8080
AGENT_PORT=8000
CV_PORT=5000

CV_BASE_URL=http://cv-service:5000
AGENT_BASE_URL=http://ai-agent:8000
RESET_PASSWORD_URL=http://localhost:8080/reset-password

# --- Flutter Frontend Build Define ---
API_BASE_URL=http://localhost:8080

